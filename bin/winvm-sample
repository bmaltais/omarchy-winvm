#!/bin/bash
# One JSON line describing the Omarchy Windows VM, read without privileges.
#
# The VM runs as root inside Docker, and this user is deliberately not in the
# docker group, so `docker stats` is out. Everything needed is world-readable
# anyway: the container's cgroup has CPU, memory and I/O counters, and the
# qemu process's /proc entry has its network namespace and its own command
# line (which says how many vCPUs and how much RAM the guest was given).
#
# Counters are emitted raw; the widget keeps the previous sample and does the
# rate arithmetic, so a dropped tick costs one refresh rather than a wrong number.

set -u
shopt -s nullglob

# dockurr/windows starts qemu with `-name Windows,process=windows`, so the
# guest shows up with comm "windows". Find the docker scope that holds it.
pid="" scope=""
for s in /sys/fs/cgroup/system.slice/docker-*.scope; do
  while read -r p; do
    [[ -r /proc/$p/comm ]] || continue
    [[ $(</proc/$p/comm) == windows ]] || continue
    exe=$(tr '\0' '\n' <"/proc/$p/cmdline" 2>/dev/null | head -1)
    [[ $exe == qemu-system-* ]] || continue
    pid=$p scope=$s
    break 2
  done <"$s/cgroup.procs" 2>/dev/null
done

if [[ -z $pid ]]; then
  # "installed" lets the widget stay in the bar, offering Start, only on a
  # machine that has the VM set up (the installer saves these credentials).
  installed=false
  [[ -f $HOME/.config/windows/credentials ]] && installed=true
  printf '{"running":false,"installed":%s}\n' "$installed"
  exit 0
fi

cid=${scope##*/docker-}
cid=${cid%.scope}

cpu_usec=$(awk '$1=="usage_usec"{print $2}' "$scope/cpu.stat" 2>/dev/null)
mem_bytes=$(<"$scope/memory.current")
mem_peak=$(cat "$scope/memory.peak" 2>/dev/null || echo 0)

# io.stat lists the NVMe and the dm-crypt device stacked on it, carrying the
# same bytes twice. Summing would double-count; the busiest single device is
# the real figure.
read -r io_read io_write < <(awk '
  { r=0; w=0
    for (i=2;i<=NF;i++) { split($i,kv,"="); if (kv[1]=="rbytes") r=kv[2]; if (kv[1]=="wbytes") w=kv[2] }
    if (r+w > best) { best=r+w; br=r; bw=w } }
  END { printf "%d %d\n", br, bw }' "$scope/io.stat" 2>/dev/null)

# eth0 inside the container is the guest's uplink. rx is what the guest
# downloaded, tx what it sent.
read -r net_rx net_tx < <(awk -F'[: ]+' '$2=="eth0"{print $3, $11}' "/proc/$pid/net/dev" 2>/dev/null)

# Allocation from qemu's own arguments: `-smp 2,sockets=...` and `-m 4G`.
mapfile -t args < <(tr '\0' '\n' <"/proc/$pid/cmdline")
vcpus=0 ram="" 
for ((i = 0; i < ${#args[@]}; i++)); do
  case ${args[i]} in
    -smp) vcpus=${args[i+1]%%,*} ;;
    -m) ram=${args[i+1]} ;;
  esac
done
case $ram in
  *G) ram_bytes=$(( ${ram%G} * 1024 * 1024 * 1024 )) ;;
  *M) ram_bytes=$(( ${ram%M} * 1024 * 1024 )) ;;
  *) ram_bytes=0 ;;
esac

# Guest uptime from the qemu process start time (field 22, in clock ticks).
start_ticks=$(awk '{print $22}' "/proc/$pid/stat")
uptime_s=$(awk -v st="$start_ticks" -v hz="$(getconf CLK_TCK)" '{printf "%d", $1 - st/hz}' /proc/uptime)

# Sparse image: apparent size is the virtual disk, allocated blocks are what
# Windows has actually written.
img="$HOME/.windows/data.img"
disk_size=0 disk_used=0
if [[ -f $img ]]; then
  read -r disk_size blocks < <(stat -c '%s %b' "$img")
  disk_used=$((blocks * 512))
fi

rdp=false
"${BASH_SOURCE[0]%/*}/winvm-rdp" open && rdp=true

host_cores=$(nproc)
host_mem=$(awk '/^MemTotal:/{print $2 * 1024}' /proc/meminfo)

printf '{"running":true,"pid":%d,"container":"%s","cpuUsec":%d,"memBytes":%d,"memPeak":%d,"ioRead":%d,"ioWrite":%d,"netRx":%d,"netTx":%d,"vcpus":%d,"ramBytes":%d,"uptime":%d,"diskSize":%d,"diskUsed":%d,"rdp":%s,"hostCores":%d,"hostMem":%d}\n' \
  "$pid" "${cid:0:12}" "${cpu_usec:-0}" "${mem_bytes:-0}" "${mem_peak:-0}" "${io_read:-0}" "${io_write:-0}" \
  "${net_rx:-0}" "${net_tx:-0}" "${vcpus:-0}" "${ram_bytes:-0}" "${uptime_s:-0}" "$disk_size" "$disk_used" \
  "$rdp" "$host_cores" "$host_mem"
