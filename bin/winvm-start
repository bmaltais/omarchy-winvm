#!/bin/bash
# Start the Windows VM without opening a window.
#
# When this user can already talk to Docker (docker group, or sudoless Docker)
# and the container exists, `docker start` brings it back with no prompt. That
# is what winvm-stop leaves behind. The plugin never grants itself Docker
# access; it only uses what the user already has.
#
# Otherwise (first start, after `omarchy-windows-vm stop` removed the
# container, after a reboot dropped the protected mounts, or no Docker access)
# fall back to the launcher, which does the privileged bring-up and asks once.
# That also opens an RDP window; --keep-alive leaves the VM running when it
# closes.
#
# The container sets the setgid bit on ~/Windows while it runs, and the
# launcher's mount check then fails on the next start without saying why
# (omacom/omarchy#13244). Clear the bit first.

set -u

CONTAINER=omarchy-windows

chmod g-s "$HOME/Windows" 2>/dev/null

if docker inspect "$CONTAINER" >/dev/null 2>&1 && docker start "$CONTAINER" >/dev/null 2>&1; then
  exit 0
fi

exec omarchy-windows-vm launch --keep-alive
