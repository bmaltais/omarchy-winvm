#!/bin/bash
# One value from the Windows login the Omarchy installer saved.
#
#   winvm-credential USERNAME|PASSWORD
#       Print the value, with no newline. Exit 1 when the file, the key or
#       the value is missing.
#
# The value goes to stdout for the caller to capture, never onto a command
# line. WINVM_CREDENTIALS names another file, for the tests.

set -u

FILE=${WINVM_CREDENTIALS:-$HOME/.config/windows/credentials}

(($# == 1)) || { echo "usage: winvm-credential USERNAME|PASSWORD" >&2; exit 2; }

[[ -f $FILE ]] || exit 1
# Split on the first = only: a password may contain one.
while IFS='=' read -r key value; do
  [[ $key == "$1" && -n $value ]] && { printf '%s' "$value"; exit 0; }
done <"$FILE"
exit 1
