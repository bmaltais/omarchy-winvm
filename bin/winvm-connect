#!/bin/bash
# Focus the Windows VM's RDP window, or open a new one if none is up.
#
# `omarchy-windows-vm launch` would also get you a window, but on a VM that is
# already running it re-runs the privileged bring-up and asks for a password
# just to reconnect. The VM is up; all that's missing is the RDP client, and
# that needs nothing more than the credentials the installer already saved.
#
# A session opened here does not stop the VM when it closes. That lifecycle
# belongs to the `launch` that started the VM, and it is still waiting on its
# own window.

set -u

if [[ ${1:-} != --open ]]; then
  exec omarchy-launch-or-focus xfreerdp "$0 --open"
fi

here=${BASH_SOURCE[0]%/*}

# No guessing: `docker`/`admin` are the image's well-known defaults, and a
# plugin that silently tries them is one nobody asked to try them.
if ! WIN_USER=$("$here/winvm-credential" USERNAME) || ! WIN_PASS=$("$here/winvm-credential" PASSWORD); then
  notify-send -u critical "Windows VM" \
    "No saved credentials in ~/.config/windows/credentials. Connect with: omarchy-windows-vm launch"
  exit 1
fi

# Same realm-less Kerberos config the launcher writes, for the same reason:
# without it FreeRDP goes looking for MIT's KDC and hangs when offline.
KRB5_CONF="$HOME/.config/windows/krb5.conf"
if [[ ! -f $KRB5_CONF ]]; then
  mkdir -p "$(dirname "$KRB5_CONF")"
  printf '[libdefaults]\n  dns_lookup_kdc = false\n  dns_lookup_realm = false\n' >"$KRB5_CONF"
fi
export KRB5_CONFIG="$KRB5_CONF"

# Match the launcher's scaling so a reconnect looks the same as a launch.
scale=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .scale')
pct=$(awk -v s="$scale" 'BEGIN { print int(s * 100) }')
rdp_scale=()
if ((pct >= 170)); then rdp_scale=(/scale:180)
elif ((pct >= 130)); then rdp_scale=(/scale:140)
fi

# Maximize or fullscreen the window, per the mode saved by the panel's cog
# (bin/winvm-mode). Both are Hyprland's own states: "maximized" fills the screen
# but leaves the bar and gaps alone, "fullscreen" covers everything. FreeRDP has
# no flag for maximized (/f is fullscreen, /w and /h are fixed sizes), so wait
# for our window to map and ask the compositor. Only the window titled below is
# touched, and giving up after 30s leaves it as it came. "windowed" leaves it
# alone entirely.
mode=$("$here/winvm-mode" get)
if [[ $mode != windowed ]]; then
  (
    for _ in $(seq 60); do
      addr=$(hyprctl clients -j | jq -r '.[] | select(.class == "xfreerdp" and .title == "Windows VM - Omarchy") | .address' | head -1)
      if [[ -n $addr ]]; then
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
        hyprctl dispatch "hl.dsp.window.fullscreen({ mode = \"$mode\", action = \"set\" })" >/dev/null
        exit 0
      fi
      sleep 0.5
    done
  ) &
fi
# Arguments go through a file descriptor rather than argv, so the password
# never appears in /proc/<pid>/cmdline, which every local user can read.
# /args-from takes the whole command line, so the window title isn't in argv
# either; bin/winvm-rdp run marks the process so its other verbs can find it.
# /cert:ignore is safe only because the target is the local container.
exec 3<<ARGS
/u:$WIN_USER
/p:$WIN_PASS
/v:127.0.0.1:3389
-grab-keyboard
/sound
/microphone
/clipboard
/cert:ignore
/title:Windows VM - Omarchy
/dynamic-resolution
/gfx:AVC444
/floatbar:sticky:off,default:visible,show:fullscreen
${rdp_scale[*]}
ARGS
exec "$here/winvm-rdp" run xfreerdp3 /args-from:fd:3
