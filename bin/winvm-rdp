#!/bin/bash
# Everything about the RDP sessions into the Omarchy Windows VM.
#
#   winvm-rdp open              exit 0 if a session exists, 1 if not
#   winvm-rdp close             SIGTERM every session; exit 0 even if none
#   winvm-rdp launcher-waiting  exit 0 if an `omarchy-windows-vm launch|start`
#                               without --keep-alive is alive: it stops the VM
#                               itself when its window closes
#   winvm-rdp run <cmd> [args]  exec the command marked as a session
#
# WINVM_RDP_CLIENT (process name to look for, default xfreerdp3) and
# WINVM_RDP_LAUNCHER (launcher script basename, default omarchy-windows-vm)
# exist for tests/rdp.test.sh, which points them at fake processes so a real
# session is never seen or signalled.
#
# There are three kinds of session, and none of them can be found by one test:
#   - omarchy-windows-vm up to 4.0.4 passes the arguments on argv, window
#     title included;
#   - later versions pipe them in with /args-from:stdin, so argv shows only
#     that, but the launcher itself is the parent process;
#   - `run`, used by bin/winvm-connect, which passes the arguments by file
#     descriptor, sets WINVM_RDP=1 in the environment (readable only by this
#     user) and execs the client.
# Match on argv and environment entries, not substrings: `pgrep -f` would also
# hit any shell or editor whose command text merely mentions these names.

set -u

CLIENT=${WINVM_RDP_CLIENT:-xfreerdp3}
LAUNCHER=${WINVM_RDP_LAUNCHER:-omarchy-windows-vm}

# The start time (field 22 of /proc/<pid>/stat, in clock ticks since boot)
# never changes for a process and differs for any later process that reuses
# the pid, so the pair names this exact process.
starttime() {
  local stat
  { stat=$(<"/proc/$1/stat"); } 2>/dev/null || return 1
  # The command name, in parentheses, can hold spaces; count fields after it.
  read -ra stat <<<"${stat##*) }"
  echo "${stat[19]}"
}

# Is this pid `bash <path>/<launcher> launch|start [flag]`? Sets `argv`.
is_launcher() {
  mapfile -t argv < <(tr '\0' '\n' <"/proc/$1/cmdline" 2>/dev/null)
  [[ ${argv[1]:-} == */"$LAUNCHER" && ( ${argv[2]:-} == launch || ${argv[2]:-} == start ) ]]
}

# Print every session as "<pid> <starttime>". The start time is read before
# the process is looked at, so a caller can confirm it before signalling.
sessions() {
  local pid start ppid
  for pid in $(pgrep -u "$UID" -x "$CLIENT"); do
    start=$(starttime "$pid") || continue
    if tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | grep -qx '/title:Windows VM - Omarchy' ||
      tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | grep -qx 'WINVM_RDP=1'; then
      echo "$pid $start"
      continue
    fi
    ppid=$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null)
    [[ -n $ppid ]] || continue
    is_launcher "$ppid" && echo "$pid $start"
  done
}

# Signal only the processes just found. A session that exited since then may
# have left its pid to something else, so check that the start time still
# matches right before each kill; a pid is only reused by a process that
# started later.
close() {
  local pid start
  while read -r pid start; do
    [[ -n $start && $(starttime "$pid") == "$start" ]] || continue
    kill "$pid" 2>/dev/null
  done < <(sessions)
  return 0
}

launcher_waiting() {
  local pid
  for pid in $(pgrep -u "$UID" -f "$LAUNCHER"); do
    is_launcher "$pid" || continue
    [[ ${argv[3]:-} == --keep-alive || ${argv[3]:-} == -k ]] && continue
    return 0
  done
  return 1
}

case ${1:-} in
  open) [[ -n $(sessions) ]] ;;
  close) close ;;
  launcher-waiting) launcher_waiting ;;
  run)
    shift
    (($#)) || { echo "usage: winvm-rdp run <command> [args...]" >&2; exit 2; }
    # Arguments go by file descriptor, so nothing on argv says this is the VM's
    # window; the marker is how `open` and `close` recognise it.
    export WINVM_RDP=1
    exec "$@"
    ;;
  *)
    echo "usage: winvm-rdp open | close | launcher-waiting | run <command> [args...]" >&2
    exit 2
    ;;
esac
